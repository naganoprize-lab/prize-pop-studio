{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Prize POP Studio",
  "version": "1.0.0",
  "identifier": "jp.naganoprize.prizepopstudio",
  "build": {
    "beforeBuildCommand": "python scripts/stage-desktop.py",
    "beforeDevCommand": "python scripts/stage-desktop.py",
    "frontendDist": "../desktop/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Prize POP Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'self'; form-action 'self'"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
